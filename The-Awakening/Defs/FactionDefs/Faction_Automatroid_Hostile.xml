<?xml version="1.0" encoding="utf-8"?>

<Defs>

    <FactionDef ParentName="FactionBase">

        <defName>DMS_Automatroid_Hostile</defName>

        <label>automatroid remnants</label>

        <description>Automatroids that have long since abandoned any remaining directive except the destruction of organic life. Their ancient combat protocols identify all living settlements as hostile.</description>

        <pawnSingular>automatroid</pawnSingular>
        <pawnsPlural>automatroids</pawnsPlural>

        <!-- Hidden from normal faction configuration -->
        <hidden>true</hidden>

        <!-- This is a non-humanlike machine faction -->
        <humanlikeFaction>false</humanlikeFaction>

        <!-- Permanently hostile -->
        <permanentEnemyToEveryoneExcept>
        </permanentEnemyToEveryoneExcept>

        <!-- Raid behavior -->
        <canStageAttacks>true</canStageAttacks>
        <autoFlee>false</autoFlee>
        <canUseAvoidGrid>true</canUseAvoidGrid>

        <!-- Do not allow this faction to generate immediately -->
        <earliestRaidDays>40</earliestRaidDays>

        <!-- Automatroid faction -->
        <techLevel>Spacer</techLevel>

        <!-- No settlements / world generation -->
        <maxConfigurableAtWorldCreation>0</maxConfigurableAtWorldCreation>
        <requiredCountAtGameStart>0</requiredCountAtGameStart>
        <maxCountAtGameStart>0</maxCountAtGameStart>

        <!-- Raid threat scaling -->
        <maxPawnCostPerTotalPointsCurve>
            <points>
                <li>(400,200)</li>
                <li>(900,300)</li>
                <li>(100000,10000)</li>
            </points>
        </maxPawnCostPerTotalPointsCurve>

        <raidCommonalityFromPointsCurve>
            <points>
                <li>(0,0)</li>
                <li>(100000,0.25)</li>
            </points>
        </raidCommonalityFromPointsCurve>

        <raidLootValueFromPointsCurve>
            <points>
                <li>(0,0)</li>
                <li>(100000,10000)</li>
            </points>
        </raidLootValueFromPointsCurve>

        <!-- Normal combat groups -->
        <pawnGroupMakers>

            <li>
                <kindDef>Combat</kindDef>
                <commonality>100</commonality>

                <options>
                    <DMS_Mech_Soldat>8</DMS_Mech_Soldat>
                    <DMS_Mech_Soldat_B>4</DMS_Mech_Soldat_B>
                    <DMS_Mech_Grenadier>2</DMS_Mech_Grenadier>
                    <DMS_Mech_Kanonier>1</DMS_Mech_Kanonier>
                </options>

            </li>

        </pawnGroupMakers>

    </FactionDef>

</Defs>