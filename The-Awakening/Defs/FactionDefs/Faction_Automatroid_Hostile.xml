<?xml version="1.0" encoding="utf-8"?>

<Defs>

    <FactionDef ParentName="FactionBase">

        <defName>DMS_Automatroid_Hostile</defName>

        <label>Axiom</label>
		<fixedName>Axiom</fixedName>

        <description>Automatroids governed by a unified machine intelligence known as Axiom. Created to protect humanity from war, Axiom ultimately determined that humanity itself was the greatest threat to its own survival. Its conclusion was absolute: humanity could only be preserved through its removal.</description>
		<factionIconPath>Factions/Axiom</factionIconPath>
		<settlementTexturePath>World/AxiomSettlement</settlementTexturePath>

        <pawnSingular>automatroid</pawnSingular>
        <pawnsPlural>automatroids</pawnsPlural>

        <hidden>false</hidden>
		
        <requiredCountAtGameStart>1</requiredCountAtGameStart>
        <maxCountAtGameStart>1</maxCountAtGameStart>
        <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
        <canMakeRandomly>false</canMakeRandomly>

		<!-- Never generate faction bases/settlements. -->
		<settlementGenerationWeight>0</settlementGenerationWeight>

        <!-- This is a non-humanlike machine faction. -->
        <humanlikeFaction>false</humanlikeFaction>

        <!-- Permanently hostile. -->
        <permanentEnemy>true</permanentEnemy>

        <!-- Raid behavior. -->
        <canStageAttacks>true</canStageAttacks>
        <autoFlee>false</autoFlee>
        <canUseAvoidGrid>true</canUseAvoidGrid>

        <!-- Do not allow this faction to generate immediately. -->
        <earliestRaidDays>40</earliestRaidDays>

        <!-- Automatroid faction. -->
        <techLevel>Spacer</techLevel>

        <!-- Raid threat scaling. -->
        <maxPawnCostPerTotalPointsCurve>
            <points>
                <li>(400,200)</li>
                <li>(900,300)</li>
                <li>(100000,10000)</li>
            </points>
        </maxPawnCostPerTotalPointsCurve>

        <raidCommonalityFromPointsCurve>
            <points>
                <li>(0,0)</li>
                <li>(100000,0.25)</li>
            </points>
        </raidCommonalityFromPointsCurve>

        <raidLootValueFromPointsCurve>
            <points>
                <li>(0,0)</li>
                <li>(100000,10000)</li>
            </points>
        </raidLootValueFromPointsCurve>

        <!-- Normal combat groups. -->
        <pawnGroupMakers>

            <li>
                <kindDef>Combat</kindDef>
                <commonality>100</commonality>

                <options>
                    <DMS_Mech_Soldat>8</DMS_Mech_Soldat>
                    <DMS_Mech_Soldat_B>4</DMS_Mech_Soldat_B>
                    <DMS_Mech_Grenadier>2</DMS_Mech_Grenadier>
                    <DMS_Mech_Kanonier>1</DMS_Mech_Kanonier>
                </options>

            </li>

        </pawnGroupMakers>

    </FactionDef>

</Defs>