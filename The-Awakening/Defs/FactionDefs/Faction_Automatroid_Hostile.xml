<?xml version="1.0" encoding="utf-8"?>

<Defs>

    <FactionDef ParentName="FactionBase">
        <defName>DMS_Automatroid_Hostile</defName>
        <label>Axiom</label>
        <fixedName>Axiom</fixedName>
        <description>Automatroids governed by a unified machine intelligence known as Axiom. Created to protect humanity from war, Axiom now interprets that directive through ruthless machine logic.</description>
        <pawnSingular>automatroid</pawnSingular>
        <pawnsPlural>automatroids</pawnsPlural>
        <requiredCountAtGameStart>1</requiredCountAtGameStart>
        <factionNameMaker>NamerFactionMechanoid</factionNameMaker>
        <factionIconPath>World/WorldObjects/Expanding/Mechanoids</factionIconPath>
        <canStageAttacks>true</canStageAttacks>
        <arrivalLayerWhitelist>
            <li>Surface</li>
        </arrivalLayerWhitelist>
        <colorSpectrum>
            <li>(0.78, 0.79, 0.71)</li>
        </colorSpectrum>
        <raidCommonalityFromPointsCurve>
            <points>
                <li>(300,0)</li>
                <li>(700,1)</li>
                <li>(1400,1.8)</li>
                <li>(2800,2.2)</li>
                <li>(4000,2.6)</li>
                <li>(10000,3.0)</li>
            </points>
        </raidCommonalityFromPointsCurve>
        <humanlikeFaction>false</humanlikeFaction>
        <hidden>true</hidden>
        <autoFlee>false</autoFlee>
        <canUseAvoidGrid>false</canUseAvoidGrid>
        <techLevel>Ultra</techLevel>
        <earliestRaidDays>45</earliestRaidDays>
        <permanentEnemy>true</permanentEnemy>
        <hostileToFactionlessHumanlikes>true</hostileToFactionlessHumanlikes>
        <maxPawnCostPerTotalPointsCurve>
            <points>
                <li>(400,200)</li>
                <li>(900,300)</li>
                <li>(2000,500)</li>
                <li>(4000,1000)</li>
                <li>(10000,3000)</li>
                <li>(100000,10000)</li>
            </points>
        </maxPawnCostPerTotalPointsCurve>
        <pawnGroupMakers>
            <!-- Core line: cheap infantry and common support units -->
            <li>
                <kindDef>Combat</kindDef>
                <commonality>100</commonality>
                <options>
                    <DMS_Mech_Soldat>30</DMS_Mech_Soldat>
                    <DMS_Mech_Soldat_B>10</DMS_Mech_Soldat_B>
                    <DMS_Mech_Ronin>8</DMS_Mech_Ronin>
                    <DMS_Mech_Arquebusier>8</DMS_Mech_Arquebusier>
                    <DMS_Mech_Phalanx>8</DMS_Mech_Phalanx>
                    <DMS_Mech_Gladiator>4</DMS_Mech_Gladiator>
                    <DMS_Mech_Falcon>10</DMS_Mech_Falcon>
                    <DMS_Mech_Hyrax>6</DMS_Mech_Hyrax>
                    <DMS_Mech_EscortLifter>5</DMS_Mech_EscortLifter>
                </options>
            </li>

            <!-- Specialist formations -->
            <li>
                <kindDef>Combat</kindDef>
                <commonality>70</commonality>
                <options>
                    <DMS_Mech_Soldat>18</DMS_Mech_Soldat>
                    <DMS_Mech_Sergeant>3</DMS_Mech_Sergeant>
                    <DMS_Mech_Grenadier>8</DMS_Mech_Grenadier>
                    <DMS_Mech_Kanonier>5</DMS_Mech_Kanonier>
                    <DMS_Mech_Arquebusier>8</DMS_Mech_Arquebusier>
                    <DMS_Mech_Pioneer>6</DMS_Mech_Pioneer>
                    <DMS_Mech_Jaeger>5</DMS_Mech_Jaeger>
                    <DMS_Mech_Sniper>4</DMS_Mech_Sniper>
                    <DMS_Mech_FieldCommand>2</DMS_Mech_FieldCommand>
                    <DMS_Mech_BattleFrame>5</DMS_Mech_BattleFrame>
                    <DMS_Mech_Tachanka>2</DMS_Mech_Tachanka>
                </options>
            </li>

            <!-- Assault / breach formations -->
            <li>
                <kindDef>Combat</kindDef>
                <commonality>45</commonality>
                <options>
                    <DMS_Mech_Ronin>8</DMS_Mech_Ronin>
                    <DMS_Mech_Gladiator>8</DMS_Mech_Gladiator>
                    <DMS_Mech_Phalanx>10</DMS_Mech_Phalanx>
                    <DMS_Mech_Siegebreaker>6</DMS_Mech_Siegebreaker>
                    <DMS_Mech_Grenadier>6</DMS_Mech_Grenadier>
                    <DMS_Mech_Kanonier>4</DMS_Mech_Kanonier>
                    <DMS_Mech_BattleFrame>5</DMS_Mech_BattleFrame>
                    <DMS_Mech_Tachanka>2</DMS_Mech_Tachanka>
                </options>
            </li>

            <!-- Heavy formation. These only become practical once raid points are high enough. -->
            <li>
                <kindDef>Combat</kindDef>
                <commonality>20</commonality>
                <options>
                    <DMS_Mech_Ape>5</DMS_Mech_Ape>
                    <DMS_Mech_Iguana>4</DMS_Mech_Iguana>
                    <DMS_Mech_Gecko>3</DMS_Mech_Gecko>
                    <DMS_Mech_Mammoth>3</DMS_Mech_Mammoth>
                    <DMS_Mech_Caretta>2</DMS_Mech_Caretta>
                    <DMS_Mech_Geochelone>1</DMS_Mech_Geochelone>
                    <DMS_Mech_Geochelone_b>1</DMS_Mech_Geochelone_b>
                    <DMS_Mech_Killdozer>1</DMS_Mech_Killdozer>
                    <DMS_Mech_Killdozer_b>1</DMS_Mech_Killdozer_b>
                    <DMS_Mech_Tarbosaurus>1</DMS_Mech_Tarbosaurus>
                </options>
            </li>
        </pawnGroupMakers>
        <settlementTexturePath>Textures/World/AxiomSettlement</settlementTexturePath>
        <allowedArrivalTemperatureRange>-100~200</allowedArrivalTemperatureRange>
        <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
        <configurationListOrderPriority>900</configurationListOrderPriority>
    </FactionDef>

</Defs>
