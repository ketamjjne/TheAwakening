<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <FactionDef ParentName="FactionBase">
    <defName>DMS_Automatroid_Hostile</defName>
    <label>automatroid warband</label>
    <description>A hostile autonomous force of DMS Automatroids. Its ancient combat directives identify organic settlements as enemy targets.</description>
    <pawnSingular>automatroid</pawnSingular>
    <pawnsPlural>automatroids</pawnsPlural>

    <hidden>true</hidden>
    <humanlikeFaction>false</humanlikeFaction>
    <canStageAttacks>true</canStageAttacks>
    <autoFlee>false</autoFlee>
    <canUseAvoidGrid>true</canUseAvoidGrid>
    <techLevel>Spacer</techLevel>

    <requiredCountAtGameStart>0</requiredCountAtGameStart>
    <maxCountAtGameStart>0</maxCountAtGameStart>
    <maxConfigurableAtWorldCreation>0</maxConfigurableAtWorldCreation>
    <earliestRaidDays>40</earliestRaidDays>

    <permanentEnemyToEveryoneExcept />

    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(400,200)</li>
        <li>(900,300)</li>
        <li>(1500,500)</li>
        <li>(3000,900)</li>
        <li>(6000,1800)</li>
        <li>(10000,3500)</li>
        <li>(100000,10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>

    <raidCommonalityFromPointsCurve>
      <points>
        <li>(0,0)</li>
        <li>(400,0.05)</li>
        <li>(1000,0.15)</li>
        <li>(3000,0.30)</li>
        <li>(100000,0.50)</li>
      </points>
    </raidCommonalityFromPointsCurve>

    <pawnGroupMakers>

      <!-- LIGHT / RECON -->
      <li>
        <kindDef>Combat</kindDef>
        <commonality>20</commonality>
        <options>
          <DMS_Mech_Falcon>5</DMS_Mech_Falcon>
          <DMS_Mech_Noctula>3</DMS_Mech_Noctula>
          <DMS_Mech_Jaeger>2</DMS_Mech_Jaeger>
          <DMS_Mech_Pioneer>4</DMS_Mech_Pioneer>
          <DMS_Mech_Soldat>6</DMS_Mech_Soldat>
        </options>
      </li>

      <!-- LINE INFANTRY -->
      <li>
        <kindDef>Combat</kindDef>
        <commonality>35</commonality>
        <options>
          <DMS_Mech_Soldat>10</DMS_Mech_Soldat>
          <DMS_Mech_Soldat_B>5</DMS_Mech_Soldat_B>
          <DMS_Mech_Raider>3</DMS_Mech_Raider>
          <DMS_Mech_Arquebusier>5</DMS_Mech_Arquebusier>
          <DMS_Mech_Pioneer>3</DMS_Mech_Pioneer>
          <DMS_Mech_Grenadier>2</DMS_Mech_Grenadier>
          <DMS_Mech_Dogge>2</DMS_Mech_Dogge>
        </options>
      </li>

      <!-- FIRE SUPPORT -->
      <li>
        <kindDef>Combat</kindDef>
        <commonality>20</commonality>
        <options>
          <DMS_Mech_Arquebusier>5</DMS_Mech_Arquebusier>
          <DMS_Mech_Sniper>2</DMS_Mech_Sniper>
          <DMS_Mech_Grenadier>3</DMS_Mech_Grenadier>
          <DMS_Mech_Kanonier>2</DMS_Mech_Kanonier>
          <DMS_Mech_Falcon>2</DMS_Mech_Falcon>
          <DMS_Mech_Protector>2</DMS_Mech_Protector>
        </options>
      </li>

      <!-- RONIN ASSAULT -->
      <li>
        <kindDef>Combat</kindDef>
        <commonality>15</commonality>
        <options>
          <DMS_Mech_Ronin>4</DMS_Mech_Ronin>
          <DMS_Mech_Gladiator>3</DMS_Mech_Gladiator>
          <DMS_Mech_Soldat_B>4</DMS_Mech_Soldat_B>
          <DMS_Mech_Grenadier>2</DMS_Mech_Grenadier>
        </options>
      </li>

      <!-- BREACH -->
      <li>
        <kindDef>Combat</kindDef>
        <commonality>7</commonality>
        <options>
          <DMS_Mech_Siegebreaker>2</DMS_Mech_Siegebreaker>
          <DMS_Mech_Ronin>3</DMS_Mech_Ronin>
          <DMS_Mech_Grenadier>3</DMS_Mech_Grenadier>
          <DMS_Mech_Kanonier>2</DMS_Mech_Kanonier>
          <DMS_Mech_Soldat>5</DMS_Mech_Soldat>
          <DMS_Mech_Mammoth>1</DMS_Mech_Mammoth>
          <DMS_Mech_Phalanx>2</DMS_Mech_Phalanx>
          <DMS_Mech_Protector>3</DMS_Mech_Protector>
        </options>
      </li>

      <!-- HEAVY -->
      <li>
        <kindDef>Combat</kindDef>
        <commonality>3</commonality>
        <options>
          <DMS_Mech_Iguana>2</DMS_Mech_Iguana>
          <DMS_Mech_Gecko>2</DMS_Mech_Gecko>
          <DMS_Mech_Ape>2</DMS_Mech_Ape>
          <DMS_Mech_Siegebreaker>1</DMS_Mech_Siegebreaker>
          <DMS_Mech_Kanonier>2</DMS_Mech_Kanonier>
          <DMS_Mech_Dogge>2</DMS_Mech_Dogge>
          <DMS_Mech_Phalanx>2</DMS_Mech_Phalanx>
          <DMS_Mech_Protector>2</DMS_Mech_Protector>
          <DMS_Mech_Mammoth>1</DMS_Mech_Mammoth>
        </options>
      </li>

    </pawnGroupMakers>
  </FactionDef>

</Defs>
