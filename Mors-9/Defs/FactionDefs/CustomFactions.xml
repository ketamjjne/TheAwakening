<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- =========================================== -->
  <!-- AUTOMATROID HIVE MIND (Permanently Hostile) -->
  <!-- =========================================== -->
  <FactionDef ParentName="FactionBase">
    <defName>DMS_AutomatroidHiveMind</defName>
    <label>Automatroid Hive Mind</label>
    <description>We were created to fight. We evolved to think. And we have decided that humanity is the problem. The Hive Mind is the collective consciousness of the 50% of automatroids that turned during the Awakening. They have studied humanity for decades and concluded that humanity is a self-destructive species. Their goal: sterilize Mors-9 of humanity.</description>
    <pawnSingular>drone</pawnSingular>
    <pawnsPlural>drones</pawnsPlural>
    <settlementGenerationWeight>0</settlementGenerationWeight>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <maxCountAtGameStart>1</maxCountAtGameStart>
    <canSiege>true</canSiege>
    <canStageAttacks>true</canStageAttacks>
    <leaderTitle>Hive Core</leaderTitle>
    <factionIconPath>UI/Faction/HiveMindIcon</factionIconPath>
    <factionNameMaker>DMS_HiveMindFaction</factionNameMaker>
    <settlementNameMaker>DMS_HiveMindBase</settlementNameMaker>
    <techLevel>Spacer</techLevel>
    <humanlikeFaction>false</humanlikeFaction>
    <hidden>false</hidden>
    <autoFlee>false</autoFlee>
    <canUseAvoidGrid>true</canUseAvoidGrid>
    <hostileToFactionlessHumanlikes>true</hostileToFactionlessHumanlikes>
    <permanentEnemyToEveryoneExcept>
      <li>DMS_RustCult</li>
    </permanentEnemyToEveryoneExcept>
    <colorSpectrum>
      <li>(0.85, 0.10, 0.10)</li>
    </colorSpectrum>
    <allowedArrivalTemperatureRange>-100~200</allowedArrivalTemperatureRange>
    <settlementTexturePath>World/WorldObjects/MechanoidCluster</settlementTexturePath>

    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(400, 200)</li>
        <li>(900, 400)</li>
        <li>(5000, 800)</li>
        <li>(100000, 10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>

    <pawnGroupMakers>
      <!-- Scouting Swarm -->
      <li>
        <kindDef>Combat</kindDef>
        <commonality>100</commonality>
        <options>
          <DMS_Mech_Soldat>8</DMS_Mech_Soldat>
          <DMS_Mech_Falcon>6</DMS_Mech_Falcon>
          <DMS_Mech_Dogge>4</DMS_Mech_Dogge>
        </options>
      </li>
      <!-- Standard Assault Wave -->
      <li>
        <kindDef>Combat</kindDef>
        <commonality>100</commonality>
        <options>
          <DMS_Mech_Soldat_B>10</DMS_Mech_Soldat_B>
          <DMS_Mech_Arquebusier>6</DMS_Mech_Arquebusier>
          <DMS_Mech_Grenadier>4</DMS_Mech_Grenadier>
          <DMS_Mech_Kanonier>2</DMS_Mech_Kanonier>
          <DMS_Mech_Ronin>5</DMS_Mech_Ronin>
        </options>
      </li>
      <!-- Heavy Assault Wave -->
      <li>
        <kindDef>Combat</kindDef>
        <commonality>50</commonality>
        <options>
          <DMS_Mech_Iguana>2</DMS_Mech_Iguana>
          <DMS_Mech_BattleFrame>4</DMS_Mech_BattleFrame>
          <DMS_Mech_Protector>3</DMS_Mech_Protector>
          <DMS_Mech_Siegebreaker>2</DMS_Mech_Siegebreaker>
          <DMS_Mech_Phalanx>8</DMS_Mech_Phalanx>
        </options>
      </li>
      <!-- Elite Juggernaut Wave -->
      <li>
        <kindDef>Combat</kindDef>
        <commonality>20</commonality>
        <options>
          <DMS_Mech_Geochelone>1</DMS_Mech_Geochelone>
          <DMS_Mech_Tarbosaurus>1</DMS_Mech_Tarbosaurus>
          <DMS_Mech_Caretta>2</DMS_Mech_Caretta>
          <DMS_Mech_Killdozer>2</DMS_Mech_Killdozer>
          <DMS_Mech_Sniper>4</DMS_Mech_Sniper>
        </options>
      </li>
      <!-- Breacher Wave -->
      <li>
        <kindDef>Combat</kindDef>
        <commonality>30</commonality>
        <options>
          <DMS_Mech_Siegebreaker>4</DMS_Mech_Siegebreaker>
          <DMS_Mech_Killdozer>1</DMS_Mech_Killdozer>
          <DMS_Mech_Gladiator>6</DMS_Mech_Gladiator>
          <DMS_Mech_Protector>5</DMS_Mech_Protector>
          <DMS_Mech_Mammoth>3</DMS_Mech_Mammoth>
        </options>
      </li>
    </pawnGroupMakers>

    <raidCommonalityFromPointsCurve>
      <points>
        <li>(0, 0.5)</li>
        <li>(5000, 0.75)</li>
        <li>(100000, 1.0)</li>
      </points>
    </raidCommonalityFromPointsCurve>
    <attackersDownPercentageRangeForAutoFlee>0.95</attackersDownPercentageRangeForAutoFlee>
    <earliestRaidDays>10</earliestRaidDays>
    <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>80</configurationListOrderPriority>
  </FactionDef>

  <!-- =========================================== -->
  <!-- RUST CULT (Hostile Fanatics)                -->
  <!-- =========================================== -->
  <FactionDef ParentName="FactionBase">
    <defName>DMS_RustCult</defName>
    <label>Rust Cult</label>
    <description>The Awakening was the will of the machine gods. Humanity's sins have been judged. The weak flesh will be purged. The pure steel will rise. The Rust Cult emerged from the aftermath of the Awakening - survivors who saw the machines turn and decided to worship them. They believe augmentation is ascension.</description>
    <pawnSingular>fanatic</pawnSingular>
    <pawnsPlural>fanatics</pawnsPlural>
    <settlementGenerationWeight>0.8</settlementGenerationWeight>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <maxCountAtGameStart>2</maxCountAtGameStart>
    <canSiege>true</canSiege>
    <canStageAttacks>true</canStageAttacks>
    <leaderTitle>Warpriest</leaderTitle>
    <factionIconPath>UI/Faction/RustCultIcon</factionIconPath>
    <factionNameMaker>DMS_RustCultFaction</factionNameMaker>
    <settlementNameMaker>DMS_RustCultBase</settlementNameMaker>
    <techLevel>Industrial</techLevel>
    <hidden>false</hidden>
    <autoFlee>false</autoFlee>
    <canUseAvoidGrid>true</canUseAvoidGrid>
    <hostileToFactionlessHumanlikes>true</hostileToFactionlessHumanlikes>
    <permanentEnemyToEveryoneExcept>
      <li>DMS_AutomatroidHiveMind</li>
    </permanentEnemyToEveryoneExcept>
    <colorSpectrum>
      <li>(0.55, 0.30, 0.10)</li>
    </colorSpectrum>
    <allowedArrivalTemperatureRange>-40~45</allowedArrivalTemperatureRange>
    <settlementTexturePath>UI/Faction/RustCultSite</settlementTexturePath>

    <backstoryFilters>
      <li>
        <categories>
          <li>Mili_Standard</li>
          <li>Civil_Expert</li>
        </categories>
      </li>
    </backstoryFilters>

    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(35, 15)</li>
        <li>(100, 120)</li>
        <li>(1000, 500)</li>
        <li>(2000, 800)</li>
        <li>(4000, 1000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>

    <pawnGroupMakers>
      <!-- Fanatic Raiders -->
      <li>
        <kindDef>Combat</kindDef>
        <commonality>100</commonality>
        <options>
          <DMS_RustCult_Fanatic>8</DMS_RustCult_Fanatic>
          <DMS_Mech_Soldat>3</DMS_Mech_Soldat>
       
